# Where the Next.js server reaches the API (server-side rendering)
API_URL=http://localhost:4000/api/v1

# Where visitors' browsers reach the API (forms, analytics)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public address of this website, used for canonical URLs and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the API (WEB_REVALIDATE_SECRET). Lets the admin refresh cached pages after an edit.
# Generate with `openssl rand -hex 24`.
REVALIDATE_SECRET=
