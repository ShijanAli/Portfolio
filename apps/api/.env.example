NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public

# Auth: generate with `openssl rand -hex 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated list of allowed origins (web + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Used only by `pnpm db:seed` to create the first admin.
# Password needs 10+ characters with upper case, lower case and a number.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password

# Public URLs (links in emails, URLs of locally stored uploads)
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Email via Brevo. Leave the key empty in development: emails are logged, not sent.
# MAIL_FROM_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=
MAIL_FROM_NAME=Portfolio
MAIL_FROM_EMAIL=no-reply@example.com
ADMIN_NOTIFY_EMAIL=

# Uploads via Cloudinary. Leave empty in development: files go to apps/api/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Analytics 4 in the admin dashboard (optional). Create a service account, add its
# email as a Viewer on the GA4 property, and paste its key with \n for line breaks.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Same value as REVALIDATE_SECRET in apps/web. Without it, the website refreshes its
# cached pages on its own every 5 minutes instead of right after an edit.
WEB_REVALIDATE_SECRET=
