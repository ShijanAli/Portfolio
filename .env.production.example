# Copy to .env.production and fill in. Never commit the filled-in file.

# Your domain, without https:// or www. DNS for it, www., admin. and api. must point here.
SITE_DOMAIN=example.com

# Database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=

# Lets the API refresh the website's cached pages. Generate with: openssl rand -hex 24
REVALIDATE_SECRET=

# First admin account, created by the one-time seed command (see DEPLOYMENT.md).
# Password: 10+ characters with upper case, lower case and a number.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email (Brevo). MAIL_FROM_EMAIL must be a verified sender in your Brevo account.
BREVO_API_KEY=
MAIL_FROM_NAME=
MAIL_FROM_EMAIL=
# Where "new booking" and "new message" notifications are sent.
ADMIN_NOTIFY_EMAIL=

# Image and file uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Google Analytics numbers inside the admin dashboard
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
